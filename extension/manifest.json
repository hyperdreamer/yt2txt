{
  "manifest_version": 3,
  "name": "YT2TXT — Video to Transcript",
  "version": "0.0.10",
  "description": "Extract transcripts from YouTube and any yt-dlp supported site. Uses AI transcription when native subtitles are unavailable.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "http://[::1]:*/*",
    "https://localhost:*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT2TXT — Get Transcript"
  },
  "commands": {
    "get-transcript": {
      "suggested_key": {
        "default": "Ctrl+Shift+T",
        "mac": "Command+Shift+T"
      },
      "description": "Get transcript for the current page"
    }
  }
}
